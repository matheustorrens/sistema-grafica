# PrintMasterERP - Demo Environment Variables
# Copy this file to .env.demo and fill in the values

# Environment
VITE_ENV=demo

# Supabase (Demo - can be empty since demo uses localStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feature Flags
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_DEBUG=true
