# PrintMasterERP - Staging/Test Environment Variables
# Copy this file to .env.staging and fill in the values

# Environment
VITE_ENV=staging

# Supabase (Staging - use a separate Supabase project for testing)
VITE_SUPABASE_URL=your_staging_supabase_url
VITE_SUPABASE_ANON_KEY=your_staging_supabase_anon_key

# Feature Flags
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_DEBUG=true
